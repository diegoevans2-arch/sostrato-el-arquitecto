    {
      "id": "lAoQACwE",
      "type": "text",
      "x": 2756,
      "y": 985,
      "width": 1031,
      "height": 98,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
