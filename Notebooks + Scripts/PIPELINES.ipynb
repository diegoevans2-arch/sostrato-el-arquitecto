    "def wape(real, proy):\n",
    "    return (proy - real).abs().sum() / real.sum()\n",
    "\n",
    "\n",
    "SEG = [\"TIPO_PERIODO\", \"COD_COMPONENTE\"]\n",
    "h = euribia_serie[(euribia_serie[\"TIPO\"] == \"REAL\") & euribia_serie[\"N_SECCIONES_REALES\"].notna()].copy()\n",
    "h = h.rename(columns={\"COMPONENTE\": \"COD_COMPONENTE\"})\n",
    "h[\"TIPO_PERIODO\"] = tipo_periodo(h[\"PERIODO\"])\n",
    "\n",
    "wapes = h.groupby(SEG).apply(lambda g: pd.Series({c: wape(g[\"N_SECCIONES_REALES\"], g[c]) for c in CANDIDATAS}),\n",
    "                             include_groups=False)\n",
    "regla = pd.DataFrame({\"COL_SECCIONES\": wapes.idxmin(axis=1), \"WAPE_HIST\": wapes.min(axis=1)})\n",
    "h = h.join(regla[\"COL_SECCIONES\"], on=SEG)\n",
    "h[\"ELEGIDA\"] = h.to_numpy()[np.arange(len(h)), h.columns.get_indexer(h[\"COL_SECCIONES\"])].astype(float)\n",
    "\n",
    "agg = h.groupby(SEG).agg(N_FILAS_HIST=(\"ELEGIDA\", \"size\"), REALES=(\"N_SECCIONES_REALES\", \"sum\"), ELEG=(\"ELEGIDA\", \"sum\"))\n",
    "factor_tipo = (h.groupby(\"TIPO_PERIODO\")[\"N_SECCIONES_REALES\"].sum() / h.groupby(\"TIPO_PERIODO\")[\"ELEGIDA\"].sum())\n",
    "agg[\"FACTOR_SEGMENTO\"] = agg[\"REALES\"] / agg[\"ELEG\"]\n",
    "agg[\"FACTOR_TIPO\"] = agg.index.get_level_values(\"TIPO_PERIODO\").map(factor_tipo)\n",
    "usa_segmento = agg[\"N_FILAS_HIST\"] >= MIN_FILAS_FACTOR\n",
    "regla = regla.join(agg[[\"N_FILAS_HIST\"]])\n",
    "regla[\"FACTOR_SESGO\"] = np.where(usa_segmento, agg[\"FACTOR_SEGMENTO\"], agg[\"FACTOR_TIPO\"])\n",
    "regla[\"FUENTE_FACTOR\"] = np.where(usa_segmento, \"segmento\", \"tipo de período\")\n",
    "regla = regla.reset_index()\n",
    "\n",
    "regla.to_parquet(BBDD / \"REGLA_SECCIONES.parquet\", index=False)\n",
    "regla.round(3)"
   ]
  },
