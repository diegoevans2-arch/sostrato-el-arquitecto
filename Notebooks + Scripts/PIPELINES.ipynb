   "source": [
    "N_SIM = 100\n",
    "SEMILLA = 2049\n",
    "OBJETIVO = 202620\n",
    "CLASES_MAPA = ESPACIOS_FISICOS\n",
    "\n",
    "destino = atrib[atrib[\"PERIODO\"] == OBJETIVO].reset_index(drop=True)\n",
    "destino, miembros = asignar_pool(destino, base_ventana(OBJETIVO))\n",
    "print(\"niveles usados (% de NRC):\", (destino[\"NIVEL_PERFIL\"].fillna(\"SIN HORARIO EN LA BASE\").value_counts(normalize=True) * 100).round(1).to_dict())\n",
    "destino = destino[destino[\"POOL\"].notna()].reset_index(drop=True)\n",
    "\n",
    "# Plantillas de la base reducidas a celdas del mapa: índice de plantilla → filas (campus, día, bloque, clase, peso)\n",
    "fis = plantillas[plantillas[\"CLASE_ESPACIO\"].isin(CLASES_MAPA)]\n",
    "campus_cod, campus_cat = pd.factorize(pd.concat([fis[\"COD_CAMPUS_EDIFICIO\"], destino[\"COD_CAMPUS\"]]))\n",
    "CAMP = dict(zip(campus_cat, range(len(campus_cat))))\n",
    "DIAS = {d: i for i, d in enumerate([\"LUNES\", \"MARTES\", \"MIERCOLES\", \"JUEVES\", \"VIERNES\", \"SABADO\", \"DOMINGO\"])}\n",
    "CLAS = {c: i for i, c in enumerate(CLASES_MAPA)}\n",
    "NB = 20\n",
    "celda_sin_campus = lambda d, b, k: (d * NB + b) * len(CLAS) + k\n",
    "N_SIN_CAMPUS = len(DIAS) * NB * len(CLAS)\n",
    "\n",
    "plant_ids = miembros[[\"PERIODO\", \"NRC\"]].drop_duplicates().reset_index(drop=True)\n",
    "plant_ids[\"TID\"] = np.arange(len(plant_ids))\n",
    "cel = fis.merge(plant_ids, on=[\"PERIODO\", \"NRC\"]).sort_values(\"TID\")\n",
    "cel_resto = celda_sin_campus(cel[\"DIA\"].map(DIAS).to_numpy(), cel[\"BLOQUE\"].to_numpy(), cel[\"CLASE_ESPACIO\"].map(CLAS).to_numpy())\n",
    "cel_camp = cel[\"COD_CAMPUS_EDIFICIO\"].map(CAMP).to_numpy()\n",
    "cel_peso = cel[\"PESO_OCUPACION\"].to_numpy()\n",
    "cel_peso_sin_lc = cel[\"PESO_SEMANAS\"].to_numpy()\n",
    "inicio_t = np.searchsorted(cel[\"TID\"].to_numpy(), plant_ids[\"TID\"].to_numpy(), side=\"left\")\n",
    "fin_t = np.searchsorted(cel[\"TID\"].to_numpy(), plant_ids[\"TID\"].to_numpy(), side=\"right\")\n",
    "\n",
    "# Muestreo vectorizado: cada pool ocupa el intervalo [p, p+1) con sus miembros en pesos acumulados\n",
    "m = miembros.merge(plant_ids, on=[\"PERIODO\", \"NRC\"])\n",
    "pool_cod = {p: i for i, p in enumerate(m[\"POOL\"].unique())}\n",
    "m[\"PID\"] = m[\"POOL\"].map(pool_cod)\n",
    "m = m.sort_values([\"PID\", \"TID\"])\n",
    "m[\"ACUM\"] = m.groupby(\"PID\")[\"PESO_VENTANA\"].cumsum() / m.groupby(\"PID\")[\"PESO_VENTANA\"].transform(\"sum\")\n",
    "clave_m = m[\"PID\"].to_numpy() + m[\"ACUM\"].to_numpy() - 1e-12\n",
    "tid_m = m[\"TID\"].to_numpy()\n",
    "\n",
    "d_pid = destino[\"POOL\"].map(pool_cod).to_numpy()\n",
    "d_camp = destino[\"COD_CAMPUS\"].map(CAMP).to_numpy()\n",
    "d_fija = destino[\"NIVEL_PERFIL\"].map(NIVEL_FIJA_CAMPUS).to_numpy()\n",
    "N_CELDAS = len(CAMP) * N_SIN_CAMPUS\n",
    "rng = np.random.default_rng(SEMILLA)\n",
    "\n",
    "sims = np.zeros((N_SIM, N_CELDAS))\n",
    "sims_sin_lc = np.zeros((N_SIM, N_CELDAS))\n",
    "for s in range(N_SIM):\n",
    "    t = tid_m[np.searchsorted(clave_m, d_pid + rng.random(len(d_pid)))]\n",
    "    largo = fin_t[t] - inicio_t[t]\n",
    "    filas = np.repeat(inicio_t[t], largo) + (np.arange(largo.sum()) - np.repeat(np.cumsum(largo) - largo, largo))\n",
    "    camp = np.where(np.repeat(d_fija, largo), cel_camp[filas], np.repeat(d_camp, largo))\n",
    "    idx = camp * N_SIN_CAMPUS + cel_resto[filas]\n",
    "    sims[s] = np.bincount(idx, weights=cel_peso[filas], minlength=N_CELDAS)\n",
    "    sims_sin_lc[s] = np.bincount(idx, weights=cel_peso_sin_lc[filas], minlength=N_CELDAS)\n",
    "\n",
    "# Mapa real contado por sala: cada sala ocupa como mucho 1 por bloque (LC y NRC que comparten sala)\n",
    "real_p = (fis[fis[\"PERIODO\"] == OBJETIVO]\n",
    "          .groupby([\"EDIFICIO\", \"SALA\", \"DIA\", \"BLOQUE\", \"CLASE_ESPACIO\"])\n",
    "          .agg(OCUPADA=(\"PESO_SEMANAS\", \"sum\"), COD_CAMPUS_EDIFICIO=(\"COD_CAMPUS_EDIFICIO\", \"first\")).reset_index())\n",
    "real_p[\"OCUPADA\"] = real_p[\"OCUPADA\"].clip(upper=1)\n",
    "real = np.bincount(real_p[\"COD_CAMPUS_EDIFICIO\"].map(CAMP).to_numpy() * N_SIN_CAMPUS\n",
    "                   + celda_sin_campus(real_p[\"DIA\"].map(DIAS).to_numpy(), real_p[\"BLOQUE\"].to_numpy(),\n",
    "                                      real_p[\"CLASE_ESPACIO\"].map(CLAS).to_numpy()),\n",
    "                   weights=real_p[\"OCUPADA\"].to_numpy(), minlength=N_CELDAS)"
   ]
  },
