   "id": "87aea64b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PROG_DETALLADA_V2_202620_202625_20261026.csv: 19.051 NRC convertidos en ['202620'. '202625'] · Cirilo actualizado: 2.643.862 filas\n"
     ]
    }
   ],
   "source": [
    "# cirilo:actualizacion-athena · conversión al formato de Cirilo\n",
    "DIAS_C = [\"LUNES\", \"MARTES\", \"MIERCOLES\", \"JUEVES\", \"VIERNES\", \"SABADO\", \"DOMINGO\"]\n",
    "COLS_C = [\"PERIODO\", \"NRC\", \"MATERIA\", \"N_CURSO\", \"SECCION\", \"COMPONENTE\", \"CAMPUS\", \"NOMBRE\", \"VACANTES\", \"INSCRITOS\",\n",
    "          \"EDIFICIO\", \"SALA\", \"CAPACIDAD\", \"FECHA_INI2\", \"FECHA_TERM2\", \"HR_INICIO\", \"HR_FIN\", *DIAS_C]\n",
    "HEAT = REPO_DP / \"Heat-Map\"\n",
    "\n",
    "\n",
    "def a_hhmm(s):\n",
    "    t = pd.to_datetime(s, format=\"%H:%M:%S\")\n",
    "    return (t.dt.hour * 100 + t.dt.minute).to_numpy()\n",
    "\n",
    "\n",
    "def convertir_a_cirilo(crudo, periodos):\n",
    "    df = pd.read_csv(crudo, dtype=str, usecols=COLS_C)\n",
    "    df = df[df[\"PERIODO\"].isin(periodos)].drop_duplicates()\n",
    "    # I · sin horario fuera; ajuste al inicio / fin de bloque estándar más cercano\n",
    "    df = df[df[\"HR_INICIO\"].fillna(\"\").str.strip().ne(\"\") & df[\"HR_FIN\"].fillna(\"\").str.strip().ne(\"\")].copy()\n",
    "    bl = pd.read_csv(HEAT / \"BBDD\" / \"BLOQUES_ESTANDAR_01122025.csv\", sep=\";\", encoding=\"utf-8-sig\")\n",
    "    ini_b, fin_b = a_hhmm(bl[\"HORA INICIO\"]), a_hhmm(bl[\"HORA FIN\"])\n",
    "    hi, hf = df[\"HR_INICIO\"].astype(float).to_numpy(), df[\"HR_FIN\"].astype(float).to_numpy()\n",
    "    df[\"HR_INICIO_AUX\"] = ini_b[np.abs(hi[:, None] - ini_b[None, :]).argmin(1)]\n",
    "    df[\"HR_FIN_AUX\"] = fin_b[np.abs(hf[:, None] - fin_b[None, :]).argmin(1)]\n",
    "    # II · un registro por día marcado\n",
    "    df[\"_fila\"] = np.arange(len(df))\n",
    "    largo = df.melt(id_vars=[c for c in df.columns if c not in DIAS_C], value_vars=DIAS_C, var_name=\"DIA_SESION\", value_name=\"_m\")\n",
    "    largo = largo[largo[\"_m\"].fillna(\"\").astype(str).str.strip().ne(\"\")].drop(columns=\"_m\")\n",
    "    # III · un registro por bloque estándar contenido en el rango\n",
    "    b = pd.DataFrame({\"BLOQUE\": bl[\"BLOQUE\"], \"_bi\": ini_b, \"_bf\": fin_b})\n",
    "    ex = largo[[\"HR_INICIO_AUX\", \"HR_FIN_AUX\"]].drop_duplicates().merge(b, how=\"cross\")\n",
    "    ex = ex[(ex[\"_bi\"] >= ex[\"HR_INICIO_AUX\"]) & (ex[\"_bf\"] <= ex[\"HR_FIN_AUX\"])][[\"HR_INICIO_AUX\", \"HR_FIN_AUX\", \"BLOQUE\"]]\n",
    "    ap = largo.merge(ex, on=[\"HR_INICIO_AUX\", \"HR_FIN_AUX\"])\n",
    "    # IV · planta física vigente\n",
    "    pfv = pd.read_csv(HEAT / \"BBDD\" / \"PLANTA_FISICA_PREPROCESADA.csv\", sep=None, engine=\"python\")\n",
    "    pfv = pfv[pfv[\"Es_Mas_Actualizado\"] == 1]\n",
    "    pfv[\"clave\"] = pfv[\"Código Edificio\"].astype(str) + pfv[\"Número Sala\"].astype(str)\n",
    "    pfv = pfv.drop_duplicates(\"clave\").set_index(\"clave\")\n",
    "    clave = ap[\"EDIFICIO\"].fillna(\"\").astype(str) + ap[\"SALA\"].fillna(\"\").astype(str)\n",
    "    ap[\"CLASIFICACIÓN\"] = clave.map(pfv[\"CLASIFICACIÓN\"]).fillna(\"Sin Clasificación\")\n",
    "    ap[\"CAMPUS_AUX\"] = clave.map(pfv[\"Campus Edificio\"]).fillna(ap[\"CAMPUS\"])\n",
    "    ap[\"Capacidad Máxima Sala_pd1\"] = clave.map(pfv[\"Capacidad Máxima Sala\"])\n",
    "    ap[\"Rango_Capacidad\"] = clave.map(pfv[\"Rango_Capacidad\"]).fillna(\"Sin Capacidad\")\n",
    "    for c in (\"PERIODO\", \"NRC\"):\n",
    "        ap[c] = ap[c].astype(int)\n",
    "    for c in (\"VACANTES\", \"INSCRITOS\"):\n",
    "        ap[c] = pd.to_numeric(ap[c], errors=\"coerce\").fillna(0).astype(int)\n",
    "    for c in (\"CAPACIDAD\", \"HR_INICIO\", \"HR_FIN\"):\n",
    "        ap[c] = pd.to_numeric(ap[c], errors=\"coerce\")\n",
    "    for c in (\"FECHA_INI2\", \"FECHA_TERM2\"):\n",
    "        ap[c] = pd.to_datetime(ap[c], format=\"%d-%m-%Y\", errors=\"coerce\")\n",
    "    ap[\"BLOQUE\"] = ap[\"BLOQUE\"].astype(int)\n",
    "    return ap.sort_values([\"_fila\", \"BLOQUE\"]).drop(columns=\"_fila\").reset_index(drop=True)\n",
    "\n",
    "\n",
    "extracciones = sorted(INSUMOS.glob(\"PROG_DETALLADA_V2_*.csv\"))\n",
    "if extracciones:\n",
    "    crudo = extracciones[-1]                       # la más reciente (el nombre lleva la fecha)\n",
    "    nuevo = convertir_a_cirilo(crudo, PERIODOS_FRESCOS)\n",
    "    base_c = pd.read_parquet(HEAT / \"dash_app\" / \"BBDD\" / \"PROG_DETALLADA_PARA_HEATMAP.parquet\")\n",
    "    base_c = base_c[~base_c[\"PERIODO\"].astype(str).isin(PERIODOS_FRESCOS)]\n",
    "    actualizado = pd.concat([base_c, nuevo[[c for c in nuevo.columns if c in base_c.columns]]], ignore_index=True)\n",
    "    actualizado.to_parquet(INSUMOS / \"PROG_DETALLADA_PARA_HEATMAP_ACTUALIZADO.parquet\", index=False)\n",
    "    RUTAS[\"CIRILO\"] = INSUMOS / \"PROG_DETALLADA_PARA_HEATMAP_ACTUALIZADO.parquet\"\n",
    "    print(f\"{crudo.name}: {nuevo[['PERIODO', 'NRC']].drop_duplicates().shape[0]:,} NRC convertidos en {PERIODOS_FRESCOS} · \"\n",
    "          f\"Cirilo actualizado: {len(actualizado):,} filas\".replace(\",\", \".\"))\n",
    "else:\n",
    "    print(\"sin extracción fresca: se usa el parquet de Heat-Map\")\n"
   ]
  },
