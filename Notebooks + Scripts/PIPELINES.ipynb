    "def aplicar_regla(df, regla):\n",
    "    # df con columnas TIPO_PERIODO, COD_COMPONENTE y las N_SECCIONES_* de Euribia\n",
    "    out = df.merge(regla[SEG + [\"COL_SECCIONES\", \"FACTOR_SESGO\"]], on=SEG, how=\"left\")\n",
    "    out[\"COL_SECCIONES\"] = out[\"COL_SECCIONES\"].fillna(\"N_SECCIONES_P50\")\n",
    "    out[\"FACTOR_SESGO\"] = out[\"FACTOR_SESGO\"].fillna(1.0)\n",
    "    base = out.to_numpy()[np.arange(len(out)), out.columns.get_indexer(out[\"COL_SECCIONES\"])].astype(float)\n",
    "    out[\"N_SECCIONES_D2\"] = base\n",
    "    out[\"N_SECCIONES_PROY\"] = np.maximum(1, np.round(base * out[\"FACTOR_SESGO\"]))\n",
    "    return out"
   ]
  },
