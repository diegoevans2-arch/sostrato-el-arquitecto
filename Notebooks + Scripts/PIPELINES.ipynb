    "def factor_comparticion(periodos):\n",
    "    # salas reales ÷ Σ PESO_OCUPACION, por campus del edificio × clase, sobre los períodos indicados\n",
    "    x = plantillas[plantillas[\"PERIODO\"].isin(periodos) & plantillas[\"CLASE_ESPACIO\"].isin(ESPACIOS_FISICOS)]\n",
    "    salas = (x.groupby([\"PERIODO\", \"EDIFICIO\", \"SALA\", \"DIA\", \"BLOQUE\"])\n",
    "               .agg(OCUPADA=(\"PESO_SEMANAS\", \"sum\"), COD_CAMPUS_EDIFICIO=(\"COD_CAMPUS_EDIFICIO\", \"first\"),\n",
    "                    CLASE_ESPACIO=(\"CLASE_ESPACIO\", \"first\")))\n",
    "    salas[\"OCUPADA\"] = salas[\"OCUPADA\"].clip(upper=1)\n",
    "    num = salas.groupby([\"COD_CAMPUS_EDIFICIO\", \"CLASE_ESPACIO\"])[\"OCUPADA\"].sum()\n",
    "    den = x.groupby([\"COD_CAMPUS_EDIFICIO\", \"CLASE_ESPACIO\"])[\"PESO_OCUPACION\"].sum()\n",
    "    f = (num / den).rename(\"FACTOR_COMPARTICION\")\n",
    "    por_clase = (salas.groupby(\"CLASE_ESPACIO\")[\"OCUPADA\"].sum() / x.groupby(\"CLASE_ESPACIO\")[\"PESO_OCUPACION\"].sum())\n",
    "    return f, por_clase\n",
    "\n",
    "\n",
    "PERIODOS_FACTOR = sorted(p for p in plantillas[\"PERIODO\"].unique() if p // 100 >= ULTIMO_ANIO - 1)\n",
    "FACTOR_COMP, FACTOR_COMP_CLASE = factor_comparticion(PERIODOS_FACTOR)\n",
    "FACTOR_COMP.reset_index().to_parquet(BBDD / \"FACTOR_COMPARTICION.parquet\", index=False)\n",
    "\n",
    "f = plantillas.join(FACTOR_COMP, on=[\"COD_CAMPUS_EDIFICIO\", \"CLASE_ESPACIO\"])[\"FACTOR_COMPARTICION\"]\n",
    "f = f.fillna(plantillas[\"CLASE_ESPACIO\"].map(FACTOR_COMP_CLASE)).fillna(1.0)\n",
    "plantillas[\"PESO_MAPA\"] = plantillas[\"PESO_OCUPACION\"] * f\n",
    "plantillas.to_parquet(BBDD / \"PLANTILLAS_NRC.parquet\", index=False)\n",
    "\n",
    "print(\"períodos de calibración:\", PERIODOS_FACTOR)\n",
    "print(\"factor por clase:\", FACTOR_COMP_CLASE.round(3).to_dict())\n",
    "FACTOR_COMP.unstack(\"CLASE_ESPACIO\").round(3)"
   ]
  },
