   "source": [
    "## 0 · Configuración"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "1f6f7e6a",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# Carpeta del proyecto: la primera hacia arriba cuyo nombre parte con «Sóstrato el Arquitecto»\n",
    "RAIZ = next(p for p in [Path.cwd(), *Path.cwd().parents] if p.name.startswith(\"Sóstrato el Arquitecto\"))\n",
    "REPO_DP = RAIZ.parent                               # Data Products - Machine Learning\n",
    "DESCARGAS = Path.home() / \"Downloads\"\n",
    "BBDD = RAIZ / \"BBDD\"\n",
    "BBDD.mkdir(exist_ok=True)\n",
    "\n",
    "RUTAS = {\n",
    "    \"ARIADNA\": DESCARGAS / \"MODELO_PROYECCCIÓN_SIMPLE\" / \"PROYECCION_MATRICULA_2026_2031_28092026.parquet\",\n",
    "    \"EURIBIA_PROY\": DESCARGAS / \"Proyección Demanda Asiganturas BBDD\" / \"PROYECCION_INSCRITOS_2026_2027.csv\",\n",
    "    \"EURIBIA_SERIE\": DESCARGAS / \"Proyección Demanda Asiganturas BBDD\" / \"SERIE_COMPLETA_REAL_VS_PROYECTADO.csv\",\n",
    "    # 26-10: si existe, se usa el Cirilo ACTUALIZADO (202620 y 202625 re-extraídos de Athena con la query V2 y\n",
    "    # convertidos con scripts_fase1/actualizar_cirilo.py); si no, el parquet de Heat-Map\n",
    "    \"CIRILO\": next((r for r in [BBDD / \"insumos\" / \"PROG_DETALLADA_PARA_HEATMAP_ACTUALIZADO.parquet\",\n",
    "                                REPO_DP / \"Heat-Map\" / \"dash_app\" / \"BBDD\" / \"PROG_DETALLADA_PARA_HEATMAP.parquet\"] if r.exists())),\n",
    "    \"STVSUBJ\": REPO_DP / \"Heat-Map\" / \"BBDD\" / \"stvsubj.csv\",\n",
    "}\n",
    "faltan = [k for k, v in RUTAS.items() if not v.exists()]\n",
    "assert not faltan, f\"No encuentro: {faltan}\"\n",
    "\n",
    "# Sufijo del período → tipo de período (D3: solo pregrado y AV; el postgrado, sufijo 00, queda fuera)\n",
    "TIPO_POR_SUFIJO = {10: \"UG 10/20\", 20: \"UG 10/20\", 5: \"AV 05/15/25\", 15: \"AV 05/15/25\", 25: \"AV 05/15/25\"}\n",
    "# Decisión A (25-10): el mapa solo cuenta SALA y LABORATORIO; EXTERNO, ESPACIO UNIV y SALA VIRTUAL quedan fuera\n",
    "ESPACIOS_FISICOS = [\"SALA\", \"LABORATORIO\"]\n",
    "\n",
    "# D2: columnas de secciones de Euribia candidatas. PROMEDIO no entra: viene vacía en la proyección\n",
    "# y en la historia usa el mismo período que mide (DIAGNOSTICO_EMPALME §10.1)\n",
    "CANDIDATAS = [\"N_SECCIONES_TEORICAS_PROYECTADAS\", \"N_SECCIONES_P25\", \"N_SECCIONES_P50\",\n",
    "              \"N_SECCIONES_P75\", \"N_SECCIONES_P90\"]\n",
    "MIN_FILAS_FACTOR = 30                               # D8: menos filas → factor del tipo de período\n",
    "PERIODOS_CONTROL = [202620, 202625]"
   ]
  },
