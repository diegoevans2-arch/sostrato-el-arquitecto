    "BLOQUE_MAX = usos[usos[\"PERIODO\"] // 100 >= ULTIMO_ANIO - 1].groupby(\"CAMPUS_AUX\")[\"BLOQUE\"].max()\n",
    "DIAS_OFERTA = [\"LUNES\", \"MARTES\", \"MIERCOLES\", \"JUEVES\", \"VIERNES\", \"SABADO\"]\n",
    "\n",
    "oferta = (fis_.groupby([\"COD_CAMPUS_EDIFICIO\", \"CLASE_MAPA\", \"RANGO_CAPACIDAD\"])\n",
    "              .agg(N_ACTIVOS=(\"ACTIVO\", \"sum\"), N_OCIOSOS=(\"ACTIVO\", lambda s: (~s).sum())).reset_index())\n",
    "oferta[\"ORDEN\"] = oferta[\"RANGO_CAPACIDAD\"].map(ORDEN_RANGO)\n",
    "oferta = oferta.sort_values([\"COD_CAMPUS_EDIFICIO\", \"CLASE_MAPA\", \"ORDEN\"], ascending=[True, True, False])\n",
    "oferta[\"N_ACTIVOS_ACUM\"] = oferta.groupby([\"COD_CAMPUS_EDIFICIO\", \"CLASE_MAPA\"])[\"N_ACTIVOS\"].cumsum()   # este rango o mayor\n",
    "oferta[\"N_OCIOSOS_ACUM\"] = oferta.groupby([\"COD_CAMPUS_EDIFICIO\", \"CLASE_MAPA\"])[\"N_OCIOSOS\"].cumsum()\n",
    "oferta[\"BLOQUE_MAX\"] = oferta[\"COD_CAMPUS_EDIFICIO\"].map(BLOQUE_MAX)\n",
    "oferta = oferta.sort_values([\"COD_CAMPUS_EDIFICIO\", \"CLASE_MAPA\", \"ORDEN\"]).drop(columns=\"ORDEN\")\n",
    "oferta.to_parquet(BBDD / \"OFERTA_CELDA.parquet\", index=False)\n",
    "oferta"
   ]
