    "def tipo_periodo(periodo):\n",
    "    return pd.Series(periodo).astype(int).mod(100).map(TIPO_POR_SUFIJO).to_numpy()\n",
    "\n",
    "\n",
    "def leer_euribia(ruta):\n",
    "    # Euribia exporta con «;» y coma decimal; CURSO lleva ceros a la izquierda\n",
    "    return pd.read_csv(ruta, sep=\";\", decimal=\",\", dtype={\"CURSO\": str, \"PERIODO\": int}, low_memory=False)\n",
    "\n",
    "\n",
    "ariadna = pd.read_parquet(RUTAS[\"ARIADNA\"])\n",
    "ariadna[\"periodo\"] = ariadna[\"periodo\"].astype(int)          # viene como texto\n",
    "euribia_proy = leer_euribia(RUTAS[\"EURIBIA_PROY\"])\n",
    "euribia_serie = leer_euribia(RUTAS[\"EURIBIA_SERIE\"])\n",
    "cirilo = pd.read_parquet(RUTAS[\"CIRILO\"], columns=[\"PERIODO\", \"NRC\", \"MATERIA\", \"N_CURSO\", \"COMPONENTE\", \"CAMPUS\",\n",
    "                                                     \"CAMPUS_AUX\", \"INSCRITOS\", \"CLASIFICACIÓN\"])\n",
    "stvsubj = pd.read_csv(RUTAS[\"STVSUBJ\"], dtype=str)\n",
    "\n",
    "for nombre, df in [(\"Ariadna\", ariadna), (\"Euribia proyección\", euribia_proy),\n",
    "                   (\"Euribia serie\", euribia_serie), (\"Cirilo\", cirilo), (\"STVSUBJ\", stvsubj)]:\n",
    "    print(f\"{nombre:20s} {df.shape[0]:>10,} filas × {df.shape[1]} columnas\".replace(\",\", \".\"))"
   ]
  },
  {
