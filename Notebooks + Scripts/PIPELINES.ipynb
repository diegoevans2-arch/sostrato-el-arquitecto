    }
   ],
   "source": [
    "ULTIMO = atrib.groupby(\"SUFIJO\")[\"PERIODO\"].max()\n",
    "base_proy = pd.concat([base_ventana(p + 100) for p in ULTIMO], ignore_index=True)\n",
    "llave_serie = [\"COD_SERIE\", \"COD_COMPONENTE\", \"COD_CAMPUS\", \"SUFIJO\"]\n",
    "\n",
    "pt = plantillas.merge(base_proy[[\"PERIODO\", \"NRC\", \"PESO_VENTANA\"]], on=[\"PERIODO\", \"NRC\"])\n",
    "pt[\"HORAS_PESO\"] = pt[\"PESO_SEMANAS\"] * pt[\"PESO_VENTANA\"]\n",
    "\n",
    "perfil = pt.groupby(llave_serie + [\"DIA\", \"BLOQUE\", \"CLASE_ESPACIO\", \"RANGO_CAPACIDAD\"], dropna=False)[\"HORAS_PESO\"].sum().rename(\"PESO\").reset_index()\n",
    "perfil[\"PROPORCION\"] = perfil[\"PESO\"] / perfil.groupby(llave_serie)[\"PESO\"].transform(\"sum\")\n",
    "perfil.drop(columns=\"PESO\").to_parquet(BBDD / \"PERFIL_HORARIO.parquet\", index=False)\n",
    "\n",
    "# Por NRC: casilleros día × bloque distintos (un tramo extra no suma horas) y fracción de semanas activas\n",
    "por_casillero = pt.groupby(llave_serie + [\"PERIODO\", \"NRC\", \"DIA\", \"BLOQUE\"]).agg(\n",
    "    PESO_SEMANAS=(\"PESO_SEMANAS\", \"sum\"), PESO_VENTANA=(\"PESO_VENTANA\", \"first\"))\n",
    "por_nrc = por_casillero.groupby(llave_serie + [\"PERIODO\", \"NRC\"]).agg(\n",
    "    HORAS_SEMANA=(\"PESO_SEMANAS\", \"size\"), SEMANAS_ACTIVAS=(\"PESO_SEMANAS\", \"mean\"),\n",
    "    PESO_VENTANA=(\"PESO_VENTANA\", \"first\")).reset_index()\n",
    "\n",
    "\n",
    "def mediana_ponderada(v, w):\n",
    "    o = np.argsort(v.to_numpy()); v, w = v.to_numpy()[o], w.to_numpy()[o]\n",
    "    return v[np.searchsorted(np.cumsum(w), w.sum() / 2)]\n",
    "\n",
    "\n",
    "resumen = por_nrc.groupby(llave_serie).apply(lambda g: pd.Series({\n",
    "    \"N_NRC\": len(g),\n",
    "    \"HORAS_SEMANA_MEDIANA\": mediana_ponderada(g[\"HORAS_SEMANA\"], g[\"PESO_VENTANA\"]),\n",
    "    \"SEMANAS_ACTIVAS_MEDIA\": np.average(g[\"SEMANAS_ACTIVAS\"], weights=g[\"PESO_VENTANA\"])}),\n",
    "    include_groups=False).reset_index()\n",
    "fisica = pt.assign(F=pt[\"CLASE_ESPACIO\"].isin(ESPACIOS_FISICOS) * pt[\"HORAS_PESO\"]).groupby(llave_serie)[[\"F\", \"HORAS_PESO\"]].sum()\n",
    "resumen = resumen.merge((fisica[\"F\"] / fisica[\"HORAS_PESO\"]).rename(\"PROP_SALA_O_LAB\").reset_index(), on=llave_serie)\n",
    "\n",
    "pt[\"ANIO_ATRAS\"] = np.where(pt[\"PESO_VENTANA\"] > 0.5, 1, 2)\n",
    "dist = pt.groupby(llave_serie + [\"ANIO_ATRAS\", \"DIA\", \"BLOQUE\"])[\"PESO_SEMANAS\"].sum().unstack(\"ANIO_ATRAS\").fillna(0)\n",
    "ambos = dist.groupby(level=llave_serie).sum().gt(0).all(axis=1)        # solo series con los dos años\n",
    "dist = dist[dist.index.droplevel([\"DIA\", \"BLOQUE\"]).isin(ambos[ambos].index)]\n",
    "dist = dist / dist.groupby(level=llave_serie).transform(\"sum\")\n",
    "estab = (dist[1] - dist[2]).abs().groupby(level=llave_serie).sum().div(2).rename(\"INESTABILIDAD_DIA_BLOQUE\")\n",
    "resumen = resumen.merge(estab.reset_index(), on=llave_serie, how=\"left\")\n",
    "resumen[\"NIVEL_PROPIO\"] = resumen[\"N_NRC\"] >= MIN_NRC_PERFIL\n",
    "resumen.to_parquet(BBDD / \"PERFIL_RESUMEN.parquet\", index=False)\n",
    "\n",
    "print(f\"PERFIL_RESUMEN: {len(resumen):,} series · con perfil propio (≥{MIN_NRC_PERFIL} NRC): \"\n",
    "      f\"{resumen['NIVEL_PROPIO'].mean():.1%}\".replace(\",\", \".\"))\n",
    "print(\"inestabilidad día × bloque (series con ambos años), mediana y p75:\",\n",
    "      resumen[\"INESTABILIDAD_DIA_BLOQUE\"].quantile([0.5, 0.75]).round(3).to_dict())\n",
    "resumen.groupby(\"COD_COMPONENTE\")[[\"HORAS_SEMANA_MEDIANA\", \"SEMANAS_ACTIVAS_MEDIA\", \"PROP_SALA_O_LAB\"]].median().round(2)"
   ]
  },
