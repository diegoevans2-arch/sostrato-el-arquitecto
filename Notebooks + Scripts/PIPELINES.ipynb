   "source": [
    "pf = pd.read_csv(REPO_DP / \"Heat-Map\" / \"BBDD\" / \"PLANTA_FISICA_PREPROCESADA.csv\", sep=None, engine=\"python\")\n",
    "pf = pf[pf[\"Es_Mas_Actualizado\"] == 1].copy()\n",
    "pf[\"EDIFICIO\"] = pf[\"Código Edificio\"].astype(str)\n",
    "pf[\"SALA\"] = pf[\"Número Sala\"].astype(str)\n",
    "\n",
    "RANGOS = [(20, \"0-20\"), (40, \"21-40\"), (60, \"41-60\"), (np.inf, \"60 o más\")]\n",
    "ORDEN_RANGO = {r: i for i, (_, r) in enumerate(RANGOS)}\n",
    "rango = lambda cap: pd.cut(cap, [-np.inf] + [t for t, _ in RANGOS], labels=[r for _, r in RANGOS]).astype(str)\n",
    "CLASE_POR_COMPONENTE = {\"TEO\": \"SALA\", \"LAB\": \"LABORATORIO\", \"SIM\": \"LABORATORIO\", \"SSA\": \"LABORATORIO\"}\n",
    "\n",
    "planta = pf.drop_duplicates([\"EDIFICIO\", \"SALA\"])[[\"EDIFICIO\", \"SALA\", \"Campus Edificio\", \"Categoría Sala\",\n",
    "                                                    \"CLASIFICACIÓN\", \"Capacidad Máxima Sala\"]]\n",
    "planta.columns = [\"EDIFICIO\", \"SALA\", \"COD_CAMPUS_EDIFICIO\", \"CATEGORIA_SALA\", \"CLASE_PLANTA\", \"CAPACIDAD\"]\n",
    "planta[\"FUENTE\"] = \"planta\"\n",
    "planta[\"CLASE_MAPA\"] = planta[\"CLASE_PLANTA\"]\n",
    "\n",
    "# Espacios usados en Cirilo (pregrado y AV); la sección 1 no carga edificio y sala, se leen aquí\n",
    "usos =pd.read_parquet(RUTAS[\"CIRILO\"], columns=[\"PERIODO\", \"NRC\", \"COMPONENTE\", \"EDIFICIO\", \"SALA\", \"CAPACIDAD\",\n",
    "                                                 \"INSCRITOS\", \"CAMPUS_AUX\", \"BLOQUE\", \"CLASIFICACIÓN\"])\n",
    "usos = usos[usos[\"PERIODO\"].mod(100).isin(TIPO_POR_SUFIJO) & usos[\"SALA\"].notna() & usos[\"EDIFICIO\"].notna()]\n",
    "usos[\"EDIFICIO\"] = usos[\"EDIFICIO\"].astype(str); usos[\"SALA\"] = usos[\"SALA\"].astype(str)\n",
    "\n",
    "# Solo salas usadas en los últimos 2 años: una sala vieja que no está en la planta no es capacidad ociosa\n",
    "ULTIMO_ANIO = int(usos[\"PERIODO\"].max() // 100)\n",
    "recientes_usos = usos[usos[\"PERIODO\"] // 100 >= ULTIMO_ANIO - 1]\n",
    "clave = planta.set_index([\"EDIFICIO\", \"SALA\"]).index\n",
    "fuera = recientes_usos[~recientes_usos.set_index([\"EDIFICIO\", \"SALA\"]).index.isin(clave)]\n",
    "comp = fuera.groupby([\"EDIFICIO\", \"SALA\"]).agg(\n",
    "    COD_CAMPUS_EDIFICIO=(\"CAMPUS_AUX\", lambda s: s.mode().iat[0]),\n",
    "    COMPONENTE=(\"COMPONENTE\", lambda s: s.mode().iat[0]),\n",
    "    CAP_CIRILO=(\"CAPACIDAD\", \"max\"), MAX_INSCRITOS=(\"INSCRITOS\", \"max\")).reset_index()\n",
    "moda_edificio = planta.groupby(\"EDIFICIO\")[\"CLASE_PLANTA\"].agg(lambda s: s.mode().iat[0])\n",
    "comp[\"CLASE_MAPA\"] = comp[\"EDIFICIO\"].map(moda_edificio)\n",
    "comp[\"FUENTE\"] = np.where(comp[\"CLASE_MAPA\"].notna(), \"complemento · clase del edificio\", \"complemento · por componente\")\n",
    "comp[\"CLASE_MAPA\"] = comp[\"CLASE_MAPA\"].fillna(comp[\"COMPONENTE\"].map(CLASE_POR_COMPONENTE)).fillna(\"FUERA DEL MAPA\")\n",
    "comp[\"CAPACIDAD\"] = comp[\"CAP_CIRILO\"].where(comp[\"CAP_CIRILO\"] > 0, comp[\"MAX_INSCRITOS\"])\n",
    "comp[\"CATEGORIA_SALA\"] = None\n",
    "\n",
    "espacios = pd.concat([planta, comp[planta.columns.drop(\"CLASE_PLANTA\").tolist()]], ignore_index=True)\n",
    "espacios[\"CLASE_MAPA\"] = espacios[\"CLASE_MAPA\"].where(espacios[\"CLASE_MAPA\"].isin(ESPACIOS_FISICOS), \"FUERA DEL MAPA\")\n",
    "espacios[\"RANGO_CAPACIDAD\"] = rango(espacios[\"CAPACIDAD\"].fillna(0))\n",
    "\n",
    "# C · activo = usado al menos una vez en los últimos 2 años (pregrado y AV)\n",
    "recientes = recientes_usos[[\"EDIFICIO\", \"SALA\"]].drop_duplicates()\n",
    "espacios[\"ACTIVO\"] = espacios.set_index([\"EDIFICIO\", \"SALA\"]).index.isin(recientes.set_index([\"EDIFICIO\", \"SALA\"]).index)\n",
    "\n",
    "espacios.to_parquet(BBDD / \"OFERTA_ESPACIOS.parquet\", index=False)\n",
    "fis_ = espacios[espacios[\"CLASE_MAPA\"] != \"FUERA DEL MAPA\"]\n",
    "print(f\"espacios: {len(espacios):,} · en el mapa (sala o laboratorio): {len(fis_):,} · activos: {int(fis_['ACTIVO'].sum()):,}\".replace(\",\", \".\"))\n",
    "pd.crosstab([fis_[\"COD_CAMPUS_EDIFICIO\"], fis_[\"FUENTE\"]], [fis_[\"CLASE_MAPA\"], fis_[\"ACTIVO\"]])"
   ]
  },
