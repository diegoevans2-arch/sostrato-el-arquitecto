   "source": [
    "rec = plantillas[(plantillas[\"PERIODO\"] // 100 >= ULTIMO_ANIO - 1) & plantillas[\"CLASE_ESPACIO\"].isin(ESPACIOS_FISICOS)]\n",
    "activos = espacios[espacios[\"ACTIVO\"]].set_index([\"EDIFICIO\", \"SALA\"]).index\n",
    "cubre = rec.set_index([\"EDIFICIO\", \"SALA\"]).index.isin(activos)\n",
    "print(f\"1 · cobertura del inventario efectivo: {rec.loc[cubre, 'PESO_SEMANAS'].sum() / rec['PESO_SEMANAS'].sum():.2%}\")\n",
    "\n",
    "# Campus y clase de cada sala desde el inventario (no desde el NRC), y ocupación por sala topada en 1\n",
    "ubic = espacios.set_index([\"EDIFICIO\", \"SALA\"])[[\"COD_CAMPUS_EDIFICIO\", \"CLASE_MAPA\"]]\n",
    "por_sala = (rec.groupby([\"PERIODO\", \"EDIFICIO\", \"SALA\", \"DIA\", \"BLOQUE\"])[\"PESO_SEMANAS\"].sum().rename(\"SUMA_NRC\")\n",
    "               .reset_index().join(ubic, on=[\"EDIFICIO\", \"SALA\"]))\n",
    "por_sala[\"OCUPADA\"] = por_sala[\"SUMA_NRC\"].clip(upper=1)\n",
    "\n",
    "comparticion = por_sala.groupby([\"COD_CAMPUS_EDIFICIO\", \"CLASE_MAPA\"])[[\"OCUPADA\", \"SUMA_NRC\"]].sum()\n",
    "comparticion[\"RAZON_SALAS_SOBRE_NRC\"] = comparticion[\"OCUPADA\"] / comparticion[\"SUMA_NRC\"]\n",
    "comparticion.to_parquet(BBDD / \"COMPARTICION.parquet\")\n",
    "print(\"compartición (salas ocupadas ÷ Σ NRC), total:\",\n",
    "      round(comparticion[\"OCUPADA\"].sum() / comparticion[\"SUMA_NRC\"].sum(), 3))\n",
    "\n",
    "n_act = fis_[fis_[\"ACTIVO\"]].groupby([\"COD_CAMPUS_EDIFICIO\", \"CLASE_MAPA\"]).size().rename(\"N_ACTIVOS\")\n",
    "uso_c = (por_sala.groupby([\"PERIODO\", \"COD_CAMPUS_EDIFICIO\", \"CLASE_MAPA\", \"DIA\", \"BLOQUE\"])[\"OCUPADA\"].sum()\n",
    "            .rename(\"OCUPADOS\").reset_index().rename(columns={\"CLASE_MAPA\": \"CLASE_ESPACIO\"})\n",
    "            .merge(n_act, left_on=[\"COD_CAMPUS_EDIFICIO\", \"CLASE_ESPACIO\"], right_index=True, how=\"left\"))\n",
    "uso_c[\"TASA_USO\"] = uso_c[\"OCUPADOS\"] / uso_c[\"N_ACTIVOS\"]\n",
    "print(f\"2 · celdas sobre 100 %: {(uso_c['TASA_USO'] > 1.0001).sum()} de {len(uso_c):,}\".replace(\",\", \".\"))\n",
    "pico = (uso_c.sort_values(\"TASA_USO\", ascending=False)\n",
    "             .groupby([\"PERIODO\", \"COD_CAMPUS_EDIFICIO\", \"CLASE_ESPACIO\"]).head(1)\n",
    "             .pivot_table(index=[\"COD_CAMPUS_EDIFICIO\", \"CLASE_ESPACIO\"], columns=\"PERIODO\", values=\"TASA_USO\"))\n",
    "(pico * 100).round(0)"
   ]
