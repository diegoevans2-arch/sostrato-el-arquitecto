   "source": [
    "# cirilo:actualizacion-athena · extracción (opcional)\n",
    "import json, re, subprocess, time\n",
    "from datetime import date\n",
    "\n",
    "EXTRAER = False                                   # True: vuelve a correr la query en Athena (requiere sesión SSO vigente)\n",
    "PERIODOS_FRESCOS = [\"202620\", \"202625\"]\n",
    "QUERY_V2 = RAIZ.parents[1] / \"QUERYs actual DL\" / \"QUERYs TXT_New DL\" / \"QUERY_PROGRAMACION_DETALLADA_V2.txt\"\n",
    "INSUMOS = BBDD / \"insumos\"; INSUMOS.mkdir(exist_ok=True)\n",
    "\n",
    "\n",
    "def aws(*args, perfil=\"perfil-athena-prod\", region=\"us-east-1\"):\n",
    "    r = subprocess.run([\"aws\", *args, \"--profile\", perfil, \"--region\", region, \"--output\", \"json\"], capture_output=True, text=True)\n",
    "    if r.returncode != 0:\n",
    "        raise RuntimeError(r.stderr.strip())\n",
    "    return json.loads(r.stdout) if r.stdout.strip() else {}\n",
    "\n",
    "\n",
    "if EXTRAER:\n",
    "    filtro = \"SSBSECT_TERM_CODE IN (\" + \",\".join(f\"'{p}'\" for p in PERIODOS_FRESCOS) + \")\"\n",
    "    sql, n = re.subn(r\"SSBSECT_TERM_CODE\\s*>=\\s*'\\d{6}'\", filtro, QUERY_V2.read_text(encoding=\"utf-8\"))\n",
    "    assert n == 2, \"Se esperaban los 2 filtros de período de la query V2\"\n",
    "    cuenta = aws(\"sts\", \"get-caller-identity\")[\"Account\"]\n",
    "    salida = f\"s3://<bucket>/athena-results/"\n",
    "    qid = aws(\"athena\", \"start-query-execution\", \"--work-group\", \"primary\", \"--query-string\", sql,\n",
    "              \"--result-configuration\", f\"OutputLocation={salida}\")[\"QueryExecutionId\"]\n",
    "    while (st := aws(\"athena\", \"get-query-execution\", \"--query-execution-id\", qid)[\"QueryExecution\"])[\"Status\"][\"State\"] not in (\"SUCCEEDED\", \"FAILED\", \"CANCELLED\"):\n",
    "        time.sleep(5)\n",
    "    assert st[\"Status\"][\"State\"] == \"SUCCEEDED\", st[\"Status\"]\n",
    "    archivo = INSUMOS / f\"PROG_DETALLADA_V2_{'_'.join(PERIODOS_FRESCOS)}_{date.today():%Y%m%d}.csv\"\n",
    "    subprocess.run([\"aws\", \"s3\", \"cp\", st[\"ResultConfiguration\"][\"OutputLocation\"], str(archivo),\n",
    "                    \"--profile\", \"perfil-athena-prod\", \"--region\", \"us-east-1\"], check=True, capture_output=True)\n",
    "    print(\"extraído:\", archivo.name)\n"
   ]
  },
  {
   "cell_type": "code",
