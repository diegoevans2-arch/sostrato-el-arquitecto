      "niveles usados (% de NRC): {'SERIE': 49.3, 'MATERIA': 31.9, 'SERIE_OTRO_CAMPUS': 16.3, 'COMPONENTE_CAMPUS': 2.1, 'SIN HORARIO EN LA BASE': 0.3, 'COMPONENTE': 0.1}\n"
     ]
    }
