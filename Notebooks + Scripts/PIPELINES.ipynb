    "# 26-10: referencias actualizadas al refrescar 202620/202625 desde Athena (§0b). Antes: −0,026 · 0,114 · 0,170 · 3.938\n",
    "REFERENCIA = {\"sesgo\": -0.023, \"wape_periodo_campus\": 0.112, \"wape_periodo_campus_componente\": 0.173, \"n_combinaciones\": 3952}\n",
    "TOLERANCIA = 0.01\n",
    "\n",
    "nrc_real = (prog_hist[prog_hist[\"PERIODO\"].isin(PERIODOS_CONTROL)]\n",
    "            .groupby(LLAVE).size().rename(\"NRC_REAL\").reset_index())\n",
    "ctrl = (euribia_proy[euribia_proy[\"PERIODO\"].isin(PERIODOS_CONTROL)]\n",
    "        .rename(columns={\"CODIGO_PROGRAMABLE\": \"COD_ASIGNATURA\", \"COMPONENTE\": \"COD_COMPONENTE\", \"CAMPUS\": \"COD_CAMPUS\"})\n",
    "        .merge(nrc_real, on=LLAVE))\n",
    "ctrl[\"TIPO_PERIODO\"] = tipo_periodo(ctrl[\"PERIODO\"])\n",
    "ctrl = aplicar_regla(ctrl, regla)\n",
    "\n",
    "filas = []\n",
    "for nombre, col in [(\"P50 en todo\", \"N_SECCIONES_P50\"), (\"Regla D2\", \"N_SECCIONES_D2\"), (\"D2 + factor D8\", \"N_SECCIONES_PROY\")]:\n",
    "    camp = ctrl.groupby([\"PERIODO\", \"COD_CAMPUS\"])[[\"NRC_REAL\", col]].sum()\n",
    "    comp = ctrl.groupby([\"PERIODO\", \"COD_CAMPUS\", \"COD_COMPONENTE\"])[[\"NRC_REAL\", col]].sum()\n",
    "    filas.append({\"CRITERIO\": nombre, \"WAPE_ASIGNATURA\": wape(ctrl[\"NRC_REAL\"], ctrl[col]),\n",
    "                  \"SESGO\": ctrl[col].sum() / ctrl[\"NRC_REAL\"].sum() - 1,\n",
    "                  \"WAPE_PERIODO_CAMPUS\": wape(camp[\"NRC_REAL\"], camp[col]),\n",
    "                  \"WAPE_PERIODO_CAMPUS_COMPONENTE\": wape(comp[\"NRC_REAL\"], comp[col])})\n",
    "resumen = pd.DataFrame(filas).set_index(\"CRITERIO\")\n",
    "\n",
    "d8 = resumen.loc[\"D2 + factor D8\"]\n",
    "chequeos = {\n",
    "    \"combinaciones\": (len(ctrl), REFERENCIA[\"n_combinaciones\"], len(ctrl) == REFERENCIA[\"n_combinaciones\"]),\n",
    "    \"sesgo\": (d8[\"SESGO\"], REFERENCIA[\"sesgo\"], abs(d8[\"SESGO\"] - REFERENCIA[\"sesgo\"]) <= TOLERANCIA),\n",
    "    \"WAPE período × campus\": (d8[\"WAPE_PERIODO_CAMPUS\"], REFERENCIA[\"wape_periodo_campus\"],\n",
    "                               abs(d8[\"WAPE_PERIODO_CAMPUS\"] - REFERENCIA[\"wape_periodo_campus\"]) <= TOLERANCIA),\n",
    "    \"WAPE período × campus × componente\": (d8[\"WAPE_PERIODO_CAMPUS_COMPONENTE\"], REFERENCIA[\"wape_periodo_campus_componente\"],\n",
    "                                            abs(d8[\"WAPE_PERIODO_CAMPUS_COMPONENTE\"] - REFERENCIA[\"wape_periodo_campus_componente\"]) <= TOLERANCIA),\n",
    "}\n",
    "for k, (valor, ref, ok) in chequeos.items():\n",
    "    print(f\"{'OK    ' if ok else 'ALERTA'} {k:38s} {valor:>10.3f}  (referencia {ref})\")\n",
    "resumen.round(3)"
   ]
