   "source": [
    "agr = lambda v: v.reshape(len(CAMP), len(DIAS), NB, len(CLAS)).sum(-1).ravel()   # sin clase: campus × día × bloque\n",
    "\n",
    "\n",
    "def metricas(sm):\n",
    "    media, p10, p90 = sm.mean(0), np.percentile(sm, 10, axis=0), np.percentile(sm, 90, axis=0)\n",
    "    activas = (real > 0) | (media > 0)\n",
    "    ra, ma = agr(real), agr(media)\n",
    "    act = (ra > 0) | (ma > 0)\n",
    "    return pd.Series({\n",
    "        \"celdas activas\": int(activas.sum()),\n",
    "        \"WAPE celda (media simulada)\": np.abs(media - real)[activas].sum() / real[activas].sum(),\n",
    "        \"WAPE campus × día × bloque\": np.abs(ma - ra)[act].sum() / ra[act].sum(),\n",
    "        \"sesgo total\": media.sum() / real.sum() - 1,\n",
    "        \"correlación mapa simulado vs real\": np.corrcoef(media[activas], real[activas])[0, 1],\n",
    "        \"cobertura P10–P90\": ((real >= p10) & (real <= p90))[activas].mean(),\n",
    "        \"coincidencia top-30 celdas\": len(set(np.argsort(real)[-30:]) & set(np.argsort(media)[-30:])) / 30,\n",
    "    })\n",
    "\n",
    "\n",
    "# Factor residual fuera de muestra: períodos de los 2 años anteriores al objetivo (no incluye 202620)\n",
    "periodos_val = [p for p in plantillas[\"PERIODO\"].unique() if OBJETIVO - 200 < p < OBJETIVO]\n",
    "f_val, f_val_clase = factor_comparticion(periodos_val)\n",
    "f_celda = np.ones(N_CELDAS)\n",
    "for camp_txt, ic in CAMP.items():\n",
    "    for clase, ik in CLAS.items():\n",
    "        valor = f_val.get((camp_txt, clase), f_val_clase.get(clase, 1.0))\n",
    "        ids = ic * N_SIN_CAMPUS + celda_sin_campus(np.repeat(np.arange(len(DIAS)), NB), np.tile(np.arange(NB), len(DIAS)), ik)\n",
    "        f_celda[ids] = valor\n",
    "print(\"períodos del factor de validación:\", sorted(periodos_val))\n",
    "\n",
    "pd.DataFrame({\"sin corrección\": metricas(sims_sin_lc), \"solo LC\": metricas(sims),\n",
    "              \"LC + factor (D11)\": metricas(sims * f_celda)}).round(3)"
   ]
  },
